# The Dream Lab API gateway, called server-side only.
GATEWAY_URL=http://localhost:3000
# Google sign-in (optional): the web OAuth client id. Must also be listed in the API's GOOGLE_CLIENT_IDS.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The platform domain, used for organisation addresses (<slug>.<domain>). Read at runtime.
SITE_DOMAIN=learn.theafricandreamlab.com
